+func sortHeaderExtensionsByCanonicalOrder(headerExtensions []RTPHeaderExtensionParameter, video bool) {
+	sort.SliceStable(headerExtensions, func(first, second int) bool {
+		firstPosition := rtpext.CanonicalPosition(headerExtensions[first].URI, video)
+		secondPosition := rtpext.CanonicalPosition(headerExtensions[second].URI, video)
+		if firstPosition < 0 && secondPosition < 0 {
+			return headerExtensions[first].URI < headerExtensions[second].URI
+		}
+		if firstPosition < 0 {
+			return false
+		}
+		if secondPosition < 0 {
+			return true
+		}
+
+		return firstPosition < secondPosition
+	})
+}
