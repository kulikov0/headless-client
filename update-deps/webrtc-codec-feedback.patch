+func isResiliencyCodec(mimeType string) bool {
+	_, subtype, found := strings.Cut(mimeType, "/")
+	if !found {
+		subtype = mimeType
+	}
+	switch strings.ToLower(subtype) {
+	case "rtx", "red", "ulpfec", "flexfec-03":
+		return true
+	default:
+		return false
+	}
+}
